{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.node.json",
  "include": ["e2e/**/*.ts", "e2e/**/*.d.ts", "playwright.config.ts"],
  "compilerOptions": {
    "composite": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  }
}
