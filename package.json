{
  "name": "writellm",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "start": "bun run build && electron .",
    "test": "bun test --parallel=1",
    "test:dom": "bun test test/unit/ui test/unit/appearance test/integration/ui",
    "test:smoke": "bun run build && node scripts/electron-smoke.mjs",
    "test:mineru-live": "bun run build && node scripts/mineru-live-launcher.mjs",
    "test:ui-runtime": "bun run build && node scripts/electron-ui-runtime.mjs",
    "test:all": "bun run test && bun run test:smoke",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.test.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --diagnostic-level=error",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@blocknote/ariakit": "0.51.4",
    "@blocknote/core": "0.51.4",
    "@blocknote/react": "0.51.4",
    "@earendil-works/pi-agent-core": "0.80.6",
    "@earendil-works/pi-ai": "0.80.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "43.1.0",
    "isomorphic-git": "1.36.1",
    "lucide-react": "1.24.0",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "happy-dom": "20.10.6",
    "tailwindcss": "4.3.2",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  }
}
