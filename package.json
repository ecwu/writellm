{
  "name": "writellm",
  "version": "0.2026.9",
  "release": {
    "version": "0.2026.9.10"
  },
  "description": "A local-first AI-assisted writing workspace",
  "packageManager": "pnpm@11.28.3",
  "main": "./out/main/index.js",
  "author": "WriteLLM contributors",
  "homepage": "https://github.com/ecwu/writellm",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "11.28.3"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "check:fast": "node scripts/run-checks.mjs fast",
    "check:e2e": "node scripts/run-checks.mjs e2e",
    "check:full": "node scripts/run-checks.mjs full",
    "check:fixtures": "node scripts/run-checks.mjs fixtures",
    "check:package:smoke": "node scripts/run-package-gate.mjs --smoke-only",
    "check:package": "node scripts/run-package-gate.mjs",
    "check:release": "node scripts/run-release-gate.mjs",
    "build": "node scripts/run-checks.mjs build",
    "package": "node scripts/run-package-gate.mjs --build-only",
    "package:unpack": "node scripts/run-package-gate.mjs --build-only --unpacked-only",
    "prepare:native": "node scripts/prepare-native-target.mjs",
    "postinstall": "node scripts/prepare-native-target.mjs --install",
    "benchmark:index": "node scripts/benchmark-index.mjs",
    "benchmark:index:100k": "node scripts/benchmark-index-100k.mjs",
    "benchmark:manuscript-search": "node scripts/benchmark-manuscript-search.mjs",
    "benchmark:manuscript-replacement": "node scripts/benchmark-manuscript-replacement.mjs",
    "benchmark:trace": "node scripts/run-trace-benchmark.mjs",
    "sync:provider-logos": "node scripts/sync-models-dev-logos.mjs"
  },
  "dependencies": {
    "@ai-sdk/cohere": "4.0.54",
    "@ai-sdk/openai-compatible": "3.0.62",
    "@blocknote/core": "0.54.0",
    "@blocknote/math-block": "0.54.0",
    "@blocknote/react": "0.54.0",
    "@blocknote/shadcn": "0.54.0",
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@citation-js/plugin-csl": "0.9.0",
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@google/genai": "2.26.0",
    "@shadcn/react": "0.3.1",
    "@tanstack/react-query": "5.104.1",
    "@unified-latex/unified-latex-util-parse": "1.8.4",
    "@unified-latex/unified-latex-util-print-raw": "1.8.4",
    "ai": "7.0.127",
    "better-sqlite3": "12.11.1",
    "border-beam": "1.4.1",
    "citeproc": "2.4.63",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dockview-react": "8.4.0",
    "docx": "9.8.1",
    "fast-xml-parser": "5.11.2",
    "isomorphic-git": "1.42.6",
    "jszip": "3.10.2",
    "katex": "0.16.47",
    "kysely": "0.28.17",
    "lucide-react": "^1.49.0",
    "mermaid": "11.17.2",
    "openai": "7.27.0",
    "p-queue": "9.3.3",
    "pdfjs-dist": "6.3.289",
    "pino": "^10.1.0",
    "pino-roll": "^4.0.0",
    "prosemirror-history": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "radix-ui": "^1.6.7",
    "react-diff-viewer-continued": "4.4.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.14.1",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "sonner": "^2.0.8",
    "sqlite-vec": "0.1.9",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "0.3.2",
    "typebox": "1.3.34",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.13.0",
    "electron": "43.7.7",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "mammoth": "1.13.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.11",
    "yazl": "3.3.1"
  }
}
