{
  "name": "writellm",
  "version": "0.2026.8",
  "release": {
    "version": "0.2026.8.25"
  },
  "description": "A local-first AI-assisted writing workspace",
  "packageManager": "pnpm@11.17.0",
  "main": "./out/main/index.js",
  "author": "WriteLLM contributors",
  "homepage": "https://github.com/ecwu/writellm",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "check:unsafe": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:write": "biome lint --write .",
    "test": "node scripts/run-tests.mjs",
    "check:fast": "npm run check && npm run typecheck",
    "check:electron": "npm test && npm run build",
    "check:e2e": "npm run build && npm run test:e2e",
    "check:e2e:critical": "npm run build && npm run test:e2e:critical",
    "check:fixtures": "node scripts/verify-recovery-fixtures.mjs",
    "check:package": "node scripts/run-package-gate.mjs",
    "check:release": "node scripts/run-release-gate.mjs",
    "rebuild:native": "node scripts/prepare-native-target.mjs --install",
    "benchmark": "node scripts/benchmark-index.mjs",
    "benchmark:smoke": "node scripts/benchmark-index-100k.mjs",
    "benchmark:manuscript-search": "node scripts/benchmark-manuscript-search.mjs",
    "benchmark:manuscript-replacement": "node scripts/benchmark-manuscript-replacement.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:critical": "node scripts/run-e2e.mjs --suite=critical",
    "test:e2e:visible": "node scripts/run-e2e.mjs --visible",
    "prepare:native": "node scripts/prepare-native-target.mjs",
    "smoke:packaged-hybrid": "node scripts/run-packaged-hybrid-smoke.mjs",
    "sync:provider-logos": "node scripts/sync-models-dev-logos.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run prepare:native && npm run typecheck && electron-vite build",
    "postinstall": "node scripts/prepare-native-target.mjs --install",
    "build:unpack": "node scripts/run-package-gate.mjs --unpacked-only",
    "build:win": "node scripts/run-package-gate.mjs --target=windows-x64",
    "build:windows": "node scripts/run-package-gate.mjs --target=windows-x64",
    "build:windows-app": "node scripts/run-package-gate.mjs --target=windows-appx",
    "build:mac": "node scripts/run-package-gate.mjs",
    "build:linux": "node scripts/run-package-gate.mjs --target=linux-x64",
    "package:windows-x64": "node scripts/run-package-gate.mjs --target=windows-x64",
    "package:windows-appx": "node scripts/run-package-gate.mjs --target=windows-appx",
    "package:macos-arm64": "node scripts/run-package-gate.mjs --target=macos-arm64",
    "package:macos-x64": "node scripts/run-package-gate.mjs --target=macos-x64",
    "package:linux-x64": "node scripts/run-package-gate.mjs --target=linux-x64"
  },
  "dependencies": {
    "@ai-sdk/cohere": "4.0.29",
    "@ai-sdk/openai-compatible": "3.0.35",
    "@blocknote/core": "0.54.0",
    "@blocknote/math-block": "0.54.0",
    "@blocknote/react": "0.54.0",
    "@blocknote/shadcn": "0.54.0",
    "@citation-js/core": "0.8.2",
    "@citation-js/plugin-bibtex": "0.8.2",
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@electron-toolkit/utils": "^4.0.0",
    "@google/genai": "2.18.0",
    "@shadcn/react": "0.3.0",
    "@tanstack/react-query": "5.101.4",
    "@unified-latex/unified-latex-util-parse": "1.8.4",
    "@unified-latex/unified-latex-util-print-raw": "1.8.4",
    "ai": "7.0.77",
    "better-sqlite3": "12.11.1",
    "border-beam": "1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx": "9.7.1",
    "fast-xml-parser": "5.11.0",
    "isomorphic-git": "1.41.8",
    "jszip": "3.10.1",
    "katex": "0.16.47",
    "kysely": "0.28.17",
    "lucide-react": "^1.33.0",
    "mermaid": "11.17.0",
    "openai": "7.5.0",
    "p-queue": "9.3.3",
    "pdfjs-dist": "6.2.108",
    "pino": "^10.1.0",
    "pino-roll": "^4.0.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.2",
    "radix-ui": "^1.6.7",
    "react-diff-viewer-continued": "4.4.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.12.3",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "sonner": "^2.0.8",
    "sqlite-vec": "0.1.9",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "0.2.0",
    "typebox": "1.3.16",
    "unified": "11.0.5",
    "yaml": "2.9.0",
    "yauzl": "3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.13.0",
    "electron": "43.4.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "mammoth": "1.12.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4",
    "yazl": "3.3.1"
  }
}
