{
  "name": "writellm",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "packageManager": "pnpm@11.10.0",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "check:unsafe": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:write": "biome lint --write .",
    "test": "node scripts/run-tests.mjs",
    "benchmark": "node scripts/benchmark-index.mjs",
    "benchmark:smoke": "node scripts/benchmark-index-100k.mjs",
    "test:e2e": "playwright test",
    "prepare:native": "node scripts/prepare-sqlite-vec.mjs",
    "smoke:packaged-hybrid": "node scripts/run-packaged-hybrid-smoke.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run prepare:native && npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@ai-sdk/cohere": "4.0.10",
    "@ai-sdk/openai-compatible": "3.0.10",
    "@blocknote/core": "0.47.2",
    "@blocknote/react": "0.47.2",
    "@blocknote/shadcn": "0.47.2",
    "@earendil-works/pi-agent-core": "0.80.7",
    "@earendil-works/pi-ai": "0.80.7",
    "@electron-toolkit/utils": "^4.0.0",
    "@tanstack/react-query": "5.90.3",
    "ai": "7.0.28",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "katex": "0.16.47",
    "kysely": "0.28.3",
    "lucide-react": "^1.24.0",
    "p-queue": "9.3.1",
    "pdfjs-dist": "6.1.200",
    "pino": "^10.1.0",
    "pino-roll": "^4.0.0",
    "radix-ui": "^1.6.2",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sqlite-vec": "0.1.9",
    "tailwind-merge": "^3.6.0",
    "yauzl": "3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "43.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4",
    "yazl": "3.3.1"
  }
}
