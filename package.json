{
  "name": "writellm",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.3.4",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "start": "bun run build && electron .",
    "test": "bun test",
    "test:smoke": "bun run build && node scripts/electron-smoke.mjs",
    "test:all": "bun run test && bun run test:smoke",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json"
  },
  "dependencies": {
    "electron": "40.10.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
