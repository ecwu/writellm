        "family": "gemini-flash",
        "open_weights": false,
        "release_date": "2026-10-06",
        "last_updated": "2026-10-06",
        "modalities": {
          "input": [
            "text",
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/heic",
            "image/heif",
            "video/x-flv",
            "video/quicktime",
            "video/mpeg",
            "video/mpegs",
            "video/mpg",
            "video/mp4",
            "video/webm",
            "video/wmv",
            "video/3gpp",
            "application/pdf"
          ],
          "output": ["text", "image/png", "image/jpeg"]
        },
        "capabilities": {
          "tools": {
            "supported": false
          },
          "reasoning": {
            "supported": true,
            "default": {
              "type": "effort",
              "value": "medium"
            },
            "effort": ["minimal", "medium", "high"]
          },
          "cache": {
            "implicit": true
          },
          "structured_output": false,
          "temperature": false,
          "top_p": false,
          "top_k": false,
          "system_updates": false,
          "effort_updates": false,
          "service_tier": ["priority"]
        },
        "limit": {
          "context": 131072,
          "output": 32768
        },
        "cost": {
          "text": {
            "input": {
              "price": 1.5,
              "cache": {
                "read": 0.15
              }
            },
            "output": {
              "price": 7.5
            }
          },
          "image": {
            "output": {
              "price": 30
            }
          },
          "web_search": {
            "price": 14
          },
          "multipliers": [
            {
              "when": {
                "service_tier": {
                  "equals": "priority"
                }
              },
              "factor": {
                "text": 1.8,
                "image": 1.8
              }
            }
          ]
        },
        "api": {
          "images": {
            "base_url": "https://${GOOGLE_VERTEX_ENDPOINT}/v1beta1/projects/${GOOGLE_VERTEX_PROJECT}/locations/${GOOGLE_VERTEX_LOCATION}/publishers/google",
            "sdk": {
              "aisdk": "@ai-sdk/google-vertex",
              "opencodeai": "@opencode/ai/providers/google-vertex/images"
            }
          },
          "generate-content": {
            "base_url": "https://${GOOGLE_VERTEX_ENDPOINT}/v1beta1/projects/${GOOGLE_VERTEX_PROJECT}/locations/${GOOGLE_VERTEX_LOCATION}/publishers/google",
            "sdk": {
              "aisdk": "@ai-sdk/google-vertex",
              "opencodeai": "@opencode/ai/providers/google-vertex/gemini"
            }
          }
